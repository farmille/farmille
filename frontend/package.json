{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "panda codegen",
    "lint": "oxlint && eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm exec tsc --noEmit && pnpm exec vitest run",
    "test": "vitest",
    "test:e2e": "playwright test",
    "gen:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.types.ts",
    "gen:types:dev": "npx supabase gen types typescript --linked > src/types/database.types.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.6",
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "lucide-react": "^1.8.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@pandacss/dev": "~1.11.5",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/hast": "^3.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-oxlint": "^1.75.0",
    "happy-dom": "^20.8.9",
    "otpauth": "9.5.1",
    "oxfmt": "0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.23",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "5.0.8",
      "minimatch@10>brace-expansion": "5.0.8",
      "fast-uri": ">=3.1.4",
      "js-yaml": "4.3.0",
      "postcss": "8.5.23",
      "sharp": "0.35.3",
      "ws": ">=8.21.0"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  }
}
