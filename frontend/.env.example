# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API
API_URL=http://localhost:8000

# Public site origin (used for Supabase email redirectTo, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (GA4) — production のみ計測、空なら未計測
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (frontend client + server runtime)
# 本値は Sentry プロジェクト発行後に投入。空なら init スキップ
NEXT_PUBLIC_SENTRY_DSN=
# build 時の source map upload に使用。CI/CD secret 管理、リポジトリにコミット禁止
SENTRY_AUTH_TOKEN=
# source map 紐付け先（Sentry org / project slug）
SENTRY_ORG=
SENTRY_PROJECT=
