{
  "name": "farmille-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3007",
    "build": "next build",
    "start": "next start",
    "prepare": "panda codegen && next typegen",
    "lint": "pnpm check:component-file-names && oxlint && eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm exec tsc --noEmit && pnpm exec vitest run",
    "test": "vitest",
    "test:e2e": "playwright test",
    "gen:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.types.ts",
    "gen:types:dev": "npx supabase gen types typescript --linked > src/types/database.types.ts",
    "storybook": "storybook dev -p 6076",
    "build-storybook": "storybook build",
    "check:component-file-names": "node scripts/check-component-file-names.mjs",
    "check:stories": "node scripts/check-story-coverage.mjs",
    "check:security-patches": "node scripts/check-image-size-security-patch.mjs",
    "test:storybook:responsive": "playwright test --config=playwright.storybook.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@next/third-parties": "^16.3.8",
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.116.0",
    "gen-interface-jp": "0.8.0",
    "input-otp": "1.5.0",
    "jposta": "^0.4.16",
    "material-icons": "^1.13.14",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "2.0.8",
    "standardwebhooks": "^1.1.1",
    "unified": "^11.0.5",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@pandacss/dev": "~1.11.5",
    "@playwright/test": "1.62.0",
    "@storybook/nextjs-vite": "10.5.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/hast": "^3.0.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-oxlint": "1.78.0",
    "happy-dom": "^20.8.9",
    "otpauth": "9.5.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.23",
    "storybook": "10.5.7",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
