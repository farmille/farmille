# Backend-specific ignores only (DRY).
# Python/env/IDE/OS common entries live in the repo-root .gitignore.
# If this directory is ever split into a sub-repo, switch to self-contained mode (ADR).

# Python tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/

# Python build output (setuptools / hatch / uv build)
dist/
build/

# Railway CLI cache (preventive)
.railway/
