# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# App
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# signup の email 確認フロー要否（config.py: signup_require_email_confirm）
# dev=false（確認スキップして即 login 可）/ prod=true（確認メール経由必須、別途 Supabase SMTP 設定が前提）
SIGNUP_REQUIRE_EMAIL_CONFIRM=false

# admin が「Farmille として」製品登録する際の紐づけ先
# （Farmille 公式 maker ハウスアカウントの users.id。config.py: farmille_maker_user_id）。
# 環境ごとに異なる（dev / prod で別アカウント）。未設定だと admin の製品登録が
# 503 farmille_maker_not_configured を返す。値は backend/scripts/create_farmille_maker.py で
# 作成した id を 1Password 等から設定する。
FARMILLE_MAKER_USER_ID=

# Sentry (backend) — production のみ init、空ならスキップ
SENTRY_DSN=
