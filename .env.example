# ブラウザから参照する Supabase 設定
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# サーバー専用。ブラウザへ公開しない
SUPABASE_SECRET_KEY=your-secret-key

# 認証メール配送。本番のSMTP_URLはsmtps://user:password@host:465。
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM=Farmille <noreply@example.test>
# ローカル専用。本番には別のランダムな署名キーを設定する。
AUTH_EMAIL_HOOK_SECRET=v1,whsec_bG9jYWwtZmFybWlsbGUtZW1haWwtaG9vay10ZXN0LWtleQ==

# PDF読み取り。ANTHROPIC_API_KEY と RECAPTCHA_SECRET_KEY はサーバー専用。
# RECAPTCHA_SITE_KEY は reCAPTCHA v3 のサイトキーで、許可するドメインに手元の localhost を含める。
ANTHROPIC_API_KEY=your-anthropic-api-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# 公開サイトのオリジン
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3007

# 任意の計測・監視設定
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
